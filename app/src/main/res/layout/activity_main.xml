<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FB"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SkillForge"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#183153"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Build skills. Shape your future."
        android:textSize="14sp"
        android:textColor="#666666"
        android:layout_marginTop="6dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome back!"
        android:textSize="23sp"
        android:textStyle="bold"
        android:textColor="#183153"
        android:layout_marginTop="35dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="What would you like to achieve today?"
        android:textSize="15sp"
        android:textColor="#666666"
        android:layout_marginTop="8dp"/>

    <Button
        android:id="@+id/btnMySkills"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="My Skills"
        android:layout_marginTop="25dp"/>

    <Button
        android:id="@+id/btnExploreCareers"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="Career Explorer"
        android:layout_marginTop="12dp"/>

    <Button
        android:id="@+id/btnSkillGap"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="Skill Gap Analysis"
        android:layout_marginTop="12dp"/>

    <Button
        android:id="@+id/btnRoadmap"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="Learning Roadmap"
        android:layout_marginTop="12dp"/>

    <Button
        android:id="@+id/btnJournal"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="Learning Journal"
        android:layout_marginTop="12dp"/>

    <Button
        android:id="@+id/btnProgress"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="Progress Analytics"
        android:layout_marginTop="12dp"/>
</LinearLayout>
