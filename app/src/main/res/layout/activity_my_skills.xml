<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F5F6FC">

    <!-- Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="My Skills"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="#202D4A"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Build your abilities, one skill at a time."
        android:textSize="14sp"
        android:textColor="#7B8193"
        android:layout_marginTop="5dp"/>

    <!-- Add Skill Panel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_skill_card"
        android:elevation="3dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ADD A NEW SKILL"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#7561CF"
            android:letterSpacing="0.08"/>

        <EditText
            android:id="@+id/etSkillName"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:hint="e.g. Java, Python, Communication"
            android:textColor="#202D4A"
            android:textColorHint="#999EAD"
            android:textSize="14sp"
            android:singleLine="true"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@drawable/bg_skill_input"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Proficiency level"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#39445F"
            android:layout_marginTop="16dp"/>

        <Spinner
            android:id="@+id/spinnerLevel"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:backgroundTint="#7561CF"/>

        <Button
            android:id="@+id/btnAddSkill"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="18dp"
            android:text=" +   Add Skill"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:backgroundTint="#7561CF"
            android:stateListAnimator="@null"
            android:elevation="2dp"/>

    </LinearLayout>

    <!-- Skills Section Heading -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your Skills"
        android:textSize="21sp"
        android:textStyle="bold"
        android:textColor="#202D4A"
        android:layout_marginTop="26dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Keep track of your progress"
        android:textSize="13sp"
        android:textColor="#858B9C"
        android:layout_marginTop="3dp"/>

    <!-- Skills List -->
    <ListView
        android:id="@+id/listSkills"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:divider="@android:color/transparent"
        android:dividerHeight="12dp"
        android:clipToPadding="false"
        android:paddingBottom="12dp"
        android:background="@android:color/transparent"
        android:scrollbars="none"/>

</LinearLayout>
