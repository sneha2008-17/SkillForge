<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F5F7FB">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="My Skills"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#183153"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Track the skills you are developing."
        android:textSize="14sp"
        android:textColor="#666666"
        android:layout_marginTop="8dp"/>

    <EditText
        android:id="@+id/etSkillName"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:hint="Enter a skill (e.g. Java)"
        android:textColor="#222222"
        android:textColorHint="#999999"
        android:layout_marginTop="30dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Proficiency Level"
        android:textColor="#183153"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginTop="20dp"/>

    <Spinner
        android:id="@+id/spinnerLevel"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:backgroundTint="#183153"/>

    <Button
        android:id="@+id/btnAddSkill"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="Add Skill"
        android:layout_marginTop="20dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="My Current Skills"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#183153"
        android:layout_marginTop="30dp"/>

    <ListView
        android:id="@+id/listSkills"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"/>

</LinearLayout>
